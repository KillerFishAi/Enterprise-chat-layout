# ========== Next 应用 / Prisma ==========
# 数据库连接（PostgreSQL，必填）
DATABASE_URL="postgresql://用户名:密码@localhost:5432/数据库名"

# JWT 签名密钥（生产环境必填，建议 32 位以上随机字符串）
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# Redis 连接（可选；不填时实时消息仅本机有效，多实例需填写）
# REDIS_URL="redis://localhost:6379"

# ========== WebSocket 服务 (npm run start:ws) ==========
# 以下三项在单独跑 ws-server 时必填，且需与上面保持一致
# REDIS_URL="redis://localhost:6379"
# JWT_SECRET="与 Next 应用相同"
# DATABASE_URL="与 Next 应用相同"
# WebSocket 监听端口（可选，默认 3001）
# SOCKET_PORT=3001
